# Copy this file to .env and fill real values before running the app.
# Only the keys listed here are read by the KAVACH codebase.

# ---------------------------------------------------------------------------
# Core runtime
# ---------------------------------------------------------------------------

# Database (SQLAlchemy URL). SQLite is fine for dev; Postgres for prod.
# Examples:
#   sqlite:///./kavach.db
#   postgresql+psycopg://postgres:postgres@localhost:5432/kavach
DATABASE_URL=sqlite:///./kavach.db

# Optional API auth for sensitive routes (backtest, pipeline trigger).
# If set, callers must send header  X-API-Key: <API_AUTH_KEY>
API_AUTH_KEY=

# Warm the pipeline once on server startup so the first /war-room render
# has live data. Set to "true" if you want that behavior.
BOOTSTRAP_REFRESH_ON_STARTUP=false

# Disable HTTPS verification for corporate proxies (dev only). Set "false" to
# skip cert checks in every outbound connector call.
SSL_VERIFY=true

# ---------------------------------------------------------------------------
# LLMs — Gemini (used by the extractor, hypothesis agent, and red-team agent)
# ---------------------------------------------------------------------------

# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Extractor (raw signal → structured event) — Gemini Flash is the default.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
EXTRACTOR_MODE=auto              # auto | gemini | deterministic

# Hypothesis agent — reasoning + causal chain.
HYPOTHESIS_MODE=auto             # auto | gemini | deterministic
HYPOTHESIS_MODEL=gemini-2.5-pro
HYPOTHESIS_TIMEOUT_SECONDS=45

# Red-team agent — argues against the hypothesis.
REDTEAM_MODE=auto                # auto | gemini | deterministic
REDTEAM_MODEL=gemini-2.5-pro
REDTEAM_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# Agent tuning (optional overrides — safe defaults are baked in)
# ---------------------------------------------------------------------------

# Scenario agent — Monte Carlo paths per horizon and RNG seed.
SCENARIO_NUM_SIMULATIONS=10000
SCENARIO_RANDOM_SEED=42

# Procurement agent — India crude demand in kilo-barrels/day.
PROCUREMENT_DEMAND_KBD=1800

# Policy agent — SPR drawdown cap (Mbd) and strategic reserve target (days).
POLICY_MAX_SPR_DRAW_MBD=4.5
POLICY_STRATEGIC_RESERVE_DAYS=30

# Economic agent — macro assumptions.
# NOTE: annual import budget is set from the War Room UI (Mission bar).
# These two remain env-configurable because they change rarely.
ECON_NOMINAL_GDP_USD_BN=4000
ECON_PASS_THROUGH_TO_CPI=0.22

# ---------------------------------------------------------------------------
# News signals
# ---------------------------------------------------------------------------

# NewsAPI — https://newsapi.org (free tier: 100 requests/day)
NEWSAPI_KEY=

# The Guardian — https://open-platform.theguardian.com/access/ (free)
GUARDIAN_API_KEY=

# ReliefWeb — no key required; only base URL is configurable.
RELIEFWEB_BASE_URL=https://api.reliefweb.int/v2

# ---------------------------------------------------------------------------
# Market and energy data
# ---------------------------------------------------------------------------

# Alpha Vantage — Brent/WTI daily prices.
# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# EIA (US Energy Information Administration) — petroleum stocks.
# Get a free key at https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# FRED (Federal Reserve macro series) — Brent series and INR/USD FX.
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ---------------------------------------------------------------------------
# Shipping and weather (Digital Twin live enrichers)
# ---------------------------------------------------------------------------

# AIS Stream — free websocket vessel positions.
# Register at https://aisstream.io for a token.
AIS_STREAM_API_KEY=

# Stormglass — marine weather at chokepoints (wind/wave/visibility).
# Free tier at https://stormglass.io (10 calls/day).
STORMGLASS_API_KEY=

# OpenWeather — port congestion / storm proximity.
# Free tier at https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=
